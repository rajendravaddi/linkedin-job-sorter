
{
  "manifest_version": 3,
  "name": "LinkedIn Job Sorter",
  "version": "1.0.0",
  "description": "Sort LinkedIn job listings by posting time. Crawl multiple pages and display the newest opportunities first. Designed for desktop and laptop browsers.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": ["scripting", "sidePanel", "tabs", "storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_title": "LinkedIn Job Sorter",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/shared/messages.js",
        "src/lib/posted-time-parser.js",
        "src/lib/search-context.js",
        "src/lib/deduplicate-jobs.js",
        "src/lib/card-extractor.js",
        "src/content/content-script.js",
        "src/content/crawler.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
